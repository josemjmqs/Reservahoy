JWT_SECRET=change_me
FRONTEND_URL=http://localhost:3001
RESEND_API_KEY=change_me
MAIL_FROM=Reservahoy <reservas@mail.reservahoy.cl>

# Fotos de servicios en Cloudflare R2 (opcional: sin esto la subida queda desactivada)
# R2_ACCOUNT_ID=change_me
# R2_ACCESS_KEY_ID=change_me
# R2_SECRET_ACCESS_KEY=change_me
# R2_IMAGES_BUCKET=reservahoy-images
