generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  STAFF
}

// Qué reservas nuevas recibe un miembro por correo
enum NotifyScope {
  ALL // todas las del negocio (solo un dueño)
  OWN // solo las que atiende
  NONE
}

model Business {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  timezone  String      @default("America/Santiago")
  phone     String?
  // Dirección que ven los clientes; el enlace a Google Maps se arma con ella
  address    String?
  // Ruta del logo en R2; la API responde logoUrl (StorageService.urlFor)
  logoKey    String?
  // Color de marca de la página pública, "#rrggbb" en minúsculas
  brandColor String?
  // Al marcar una reserva como completada se le avisa al cliente que su
  // servicio está listo (negocios donde el cliente deja algo y vuelve a buscarlo)
  notifyCompleted Boolean @default(false)
  createdAt DateTime    @default(now())
  members   Member[]
  services  Service[]
  customers Customer[]
  bookings  Booking[]
  blocks    TimeBlock[]
  supportRequests SupportRequest[]
}

model User {
  id              String                   @id @default(cuid())
  email           String                   @unique
  name            String
  password        String
  emailVerifiedAt DateTime?
  // Va en el JWT (sv); al cambiar la contraseña sube y cierra las otras sesiones
  sessionVersion  Int                      @default(0)
  createdAt       DateTime                 @default(now())
  members         Member[]
  resetTokens     PasswordResetToken[]
  verifyTokens    EmailVerificationToken[]
}

model Member {
  id                String             @id @default(cuid())
  role              MemberRole
  bookable          Boolean            @default(true)
  active            Boolean            @default(true)
  // Correo por cada reserva nueva hecha desde la página pública. Parte
  // limitado (OWN), como un rol nuevo; el registro y aceptar una invitación
  // dejan al dueño en ALL
  newBookingsScope  NotifyScope        @default(OWN)
  displayName       String
  userId            String?
  businessId        String
  user              User?              @relation(fields: [userId], references: [id])
  business          Business           @relation(fields: [businessId], references: [id])
  hours             WorkingHours[]
  bookings          Booking[]
  services          MemberService[]
  invitations       MemberInvitation[]
  supportRequests   SupportRequest[]

  @@unique([userId, businessId])
  @@index([businessId])
}

// Invitación de un solo uso para que un profesional sin cuenta cree la suya.
// Solo se guarda el hash del token, como los de reset y verificación
model MemberInvitation {
  id        String    @id @default(cuid())
  email     String // normalizado (trim + minúsculas)
  tokenHash String    @unique
  expiresAt DateTime // 7 días
  usedAt    DateTime? // aceptada
  revokedAt DateTime? // anulada por el dueño o reemplazada por un reenvío
  createdAt DateTime  @default(now())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
}

model MemberService {
  memberId  String
  serviceId String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([memberId, serviceId])
}

model Service {
  id           String          @id @default(cuid())
  name         String
  description  String?
  durationMin  Int
  totalMin     Int?
  price        Int?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  businessId   String
  business     Business        @relation(fields: [businessId], references: [id])
  bookingItems BookingItem[]
  members      MemberService[]
  category     String?
  imageKey     String? // ruta de la foto en el bucket; la URL pública se arma con R2_PUBLIC_URL

  @@index([businessId])
}

model WorkingHours {
  id       String @id @default(cuid())
  weekday  Int // 0 = domingo ... 6 = sábado
  opensAt  String // "09:00"
  closesAt String // "18:00"
  // Descanso opcional (almuerzo): los dos o ninguno, dentro del horario
  breakStartsAt String? // "13:00"
  breakEndsAt   String? // "14:00"
  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  @@unique([memberId, weekday])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Customer {
  id         String    @id @default(cuid())
  name       String
  email      String
  phone      String?
  createdAt  DateTime  @default(now())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  bookings   Booking[]

  @@unique([businessId, email])
}

model Booking {
  id          String        @id @default(cuid())
  startsAt    DateTime
  endsAt      DateTime
  status      BookingStatus @default(CONFIRMED)
  notes       String?
  manageToken String        @unique @default(cuid())
  createdAt   DateTime      @default(now())
  businessId  String
  memberId    String
  customerId  String
  business    Business      @relation(fields: [businessId], references: [id])
  member      Member        @relation(fields: [memberId], references: [id])
  customer    Customer      @relation(fields: [customerId], references: [id])
  items       BookingItem[]

  @@index([businessId, startsAt])
  @@index([memberId, startsAt])
}

// Servicios de una reserva, en el orden en que se hacen (position 0, 1, ...)
model BookingItem {
  bookingId String
  serviceId String
  position  Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([bookingId, position])
  @@unique([bookingId, serviceId])
  @@index([serviceId])
}

model TimeBlock {
  id         String   @id @default(cuid())
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  businessId String
  memberId   String?
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId, startsAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Qué escribe un usuario del panel en "Ayuda y sugerencias"
enum SupportKind {
  PROBLEM // reporta un problema
  SUGGESTION // sugiere una mejora o algo nuevo
  QUESTION // tiene una duda
}

// Mensaje de un usuario del panel al equipo de Reservahoy. Se guarda aunque el
// correo no salga, y queda como historial
model SupportRequest {
  id         String      @id @default(cuid())
  kind       SupportKind
  message    String
  // Pantalla del panel desde donde se abrió (ej. /dashboard/agenda)
  page       String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  memberId   String
  businessId String
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([businessId, createdAt])
}
